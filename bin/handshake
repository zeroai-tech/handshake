#!/usr/bin/env bash
# Run Handshake from a clone, with or without a virtualenv.
#
# Prefers the repo's own .venv (how the installer sets it up), then any
# interpreter that already has `cryptography`, so `pip install -e .` works too.
set -euo pipefail

# This script is normally reached through a symlink on PATH, so resolve the
# link chain before deriving the install directory — otherwise we look for the
# venv next to the symlink instead of next to the real file. Done by hand
# because BSD readlink has no -f.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *)  SELF="$(cd "$(dirname "$SELF")" && pwd)/$LINK" ;;
  esac
done
HS_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"

if [ -x "$HS_DIR/.venv/bin/python" ]; then
  exec "$HS_DIR/.venv/bin/python" "$HS_DIR/handshake.py" "$@"
fi
for py in python3 python; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import cryptography' 2>/dev/null; then
    exec "$py" "$HS_DIR/handshake.py" "$@"
  fi
done
echo "  Handshake needs Python 3.10+ with 'cryptography'. Reinstall with:" >&2
echo "    curl -fsSL https://raw.githubusercontent.com/zeroai-tech/handshake/main/install.sh | bash" >&2
exit 1
